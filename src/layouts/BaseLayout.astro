---
import Header from '../components/Header/Header.astro';
import '../styles/main.scss';

interface Props {
  title?: string;
  description?: string;
  homePrefix?: string;
}

const {
  title = 'Apipema Center — Tudo o que você precisa, em um só lugar',
  description = 'O Apipema Center é o seu ponto de encontro em Ondina, com lojas, serviços e conveniência para o seu dia a dia.',
  homePrefix = '',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://www.apipemacenter.com.br').toString();
const ogImageUrl = new URL('/images/apipema-hero.jpg', Astro.site ?? 'https://www.apipemacenter.com.br').toString();

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ShoppingCenter',
  name: 'Apipema Center',
  url: 'https://www.apipemacenter.com.br',
  image: ogImageUrl,
  description,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Rua Professor Sabino Silva, 836',
    addressLocality: 'Salvador',
    addressRegion: 'BA',
    addressCountry: 'BR',
  },
};
---

<!doctype html>
<html lang="pt-BR" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#F7F6F0" />
    <link rel="icon" type="image/png" href="/brand/apipema-center-logo.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Apipema Center" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
  </head>
  <body>
    <div class="page-progress" aria-hidden="true" data-page-progress></div>

    <a class="skip-link" href="#conteudo-principal">
      Ir para o conteúdo principal
    </a>

    <Header homePrefix={homePrefix} />

    <main id="conteudo-principal">
      <slot />
    </main>

    <script>
      import { initPageFlow } from '../scripts/page-flow';
      import { initNavigation } from '../scripts/navigation';
      import { initHeroAnimations } from '../components/Hero/hero-animations';
      import { initStoresSection } from '../components/Stores/stores-animations';
      import { initServicesSection } from '../components/Services/services-animations';
      import { initLocationSection } from '../components/Location/location-animations';

      initPageFlow();
      initNavigation();
      initHeroAnimations();
      initStoresSection();
      initServicesSection();
      initLocationSection();
    </script>
  </body>
</html>
