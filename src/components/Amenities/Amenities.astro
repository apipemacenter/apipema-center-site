---
import Icon from '../Icon/Icon.astro';
import type { IconName } from '../Icon/Icon.astro';
import './Amenities.scss';

interface AmenityItem {
  icon: IconName;
  label: string;
  href: string;
}

const amenities: AmenityItem[] = [
  { icon: 'shopping-bag', label: 'Lojas variadas', href: '#lojas' },
  { icon: 'car', label: 'Manobrista', href: '#servicos' },
  { icon: 'map-pin', label: 'Excelente localização', href: '#como-chegar' },
];
---

<ul class="amenities" aria-label="Diferenciais do Apipema Center">
  {amenities.map((item) => (
    <li class="amenities__item" data-hero-amenity>
      <a href={item.href} class="amenities__link">
        <span class="amenities__icon" aria-hidden="true" data-amenity-icon>
          <Icon name={item.icon} size={20} strokeWidth={1.8} />
        </span>
        <span class="amenities__label">{item.label}</span>
      </a>
    </li>
  ))}
</ul>
