---
import Icon from '../Icon/Icon.astro';
import { storeBrands, storeCategories } from '../../data/stores';
import './Stores.scss';
---

<section id="lojas" class="stores" aria-labelledby="lojas-title" data-stores-section>
  <!-- Flat Design 2.0 corner arcs straddling Hero <-> Stores and Stores <-> Services seams -->
  <div class="stores__corner stores__corner--top-left" aria-hidden="true" data-stores-arc="top-left">
    <svg viewBox="0 0 360 440" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="-20" cy="220" r="210" fill="#DCE9BE" />
      <circle cx="-55" cy="195" r="195" fill="#95BE3E" />
    </svg>
  </div>

  <div class="stores__corner stores__corner--bottom-right" aria-hidden="true" data-stores-arc="bottom-right">
    <svg viewBox="0 0 440 500" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="430" cy="240" r="235" fill="#DCE9BE" />
      <circle cx="458" cy="275" r="215" fill="#95BE3E" />
    </svg>
  </div>

  <!-- Visual scroll bridge from Hero Section -->
  <div class="stores__bridge" aria-hidden="true">
    <span class="stores__bridge-line" data-stores-bridge-line></span>
    <span class="stores__bridge-dot" data-stores-bridge-dot></span>
  </div>

  <div class="container stores__container">
    <header class="stores__header">
      <div class="stores__eyebrow" data-stores-eyebrow>
        <span class="stores__eyebrow-rule" aria-hidden="true" data-stores-rule></span>
        <span class="stores__eyebrow-text">Nossas Lojas</span>
        <span class="stores__eyebrow-rule" aria-hidden="true" data-stores-rule></span>
      </div>

      <h2 id="lojas-title" class="stores__title">
        <span class="stores__title-line stores__title-line--primary" data-stores-line>
          Tudo o que você precisa,
        </span>
        <span class="stores__title-line stores__title-line--accent" data-stores-line>
          em um só lugar.
        </span>
      </h2>

      <p class="stores__lead" data-stores-lead>
        Uma variedade completa de lojas, serviços e conveniência para o seu dia a dia.
      </p>

      <div class="stores__tabs" role="tablist" aria-label="Filtrar lojas por categoria" data-stores-tabs>
        <span class="stores__tab-indicator" aria-hidden="true" data-tab-indicator></span>
        {storeCategories.map((category, index) => (
          <button
            type="button"
            role="tab"
            class:list={['stores__tab', { 'is-active': index === 0 }]}
            aria-selected={index === 0 ? 'true' : 'false'}
            data-store-tab={category}
          >
            {category}
          </button>
        ))}
      </div>
    </header>

    <div class="stores__carousel" data-stores-carousel>
      <button
        type="button"
        class="stores__nav stores__nav--prev"
        aria-label="Lojas anteriores"
        data-stores-prev
      >
        <Icon name="chevron-left" size={24} strokeWidth={1.75} />
      </button>

      <div
        class="stores__viewport"
        data-stores-viewport
        tabindex="0"
        aria-label="Marcas por categoria do Apipema Center"
      >
        <ul class="stores__track" data-stores-track>
          {storeBrands.map((brand) => (
            <li
              class="stores__slide"
              data-store-card
              data-store-category-item={brand.category}
            >
              <a
                href="/lojas"
                class:list={['store-card', `store-card--${brand.surfaceTone ?? 'light'}`]}
                data-store-interactive
                aria-label={`${brand.name} — Categoria ${brand.category}`}
              >
                <span class="store-card__sheen" aria-hidden="true"></span>

                <span class="store-card__category" data-store-category>
                  {brand.category}
                </span>

                <span
                  class:list={['store-card__media', `store-card__media--${brand.logoScale ?? 'wide'}`]}
                  data-store-media
                >
                  <img
                    src={brand.logo}
                    alt={brand.name}
                    width={brand.width}
                    height={brand.height}
                    loading="lazy"
                    decoding="async"
                    class="store-card__logo"
                  />
                </span>
              </a>
            </li>
          ))}

          <li class="stores__slide" data-store-card data-store-always-visible>
            <a
              href="/lojas"
              class="store-card store-card--more"
              data-store-interactive
              aria-label="Ver todas as lojas do Apipema Center"
            >
              <span class="store-card__sheen" aria-hidden="true"></span>
              <span class="store-card__more-text">
                e muito<br />mais!
              </span>
              <span class="store-card__more-arrow" aria-hidden="true">
                <Icon name="arrow-right" size={18} strokeWidth={2} />
              </span>
            </a>
          </li>
        </ul>
      </div>

      <button
        type="button"
        class="stores__nav stores__nav--next"
        aria-label="Próximas lojas"
        data-stores-next
      >
        <Icon name="chevron-right" size={24} strokeWidth={1.75} />
      </button>
    </div>

    <div class="stores__progress" aria-hidden="true">
      <span class="stores__progress-track">
        <span class="stores__progress-thumb" data-stores-progress></span>
      </span>
    </div>

    <div class="stores__actions">
      <a
        href="/lojas"
        class="stores__cta"
        data-magnetic-stores-cta
      >
        <span class="stores__cta-sheen" aria-hidden="true"></span>
        <span class="stores__cta-label">Conheça todas as lojas</span>
        <span class="stores__cta-icon" aria-hidden="true">
          <Icon name="arrow-right" size={18} strokeWidth={2.1} />
        </span>
      </a>
    </div>
  </div>
</section>
